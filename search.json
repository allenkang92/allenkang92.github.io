---
layout: null
---
[
  {% assign posts = site.posts | sort: 'date' | reverse %}
  {% assign has_item = false %}

  {% for post in posts %}
    {% assign series_index = nil %}
    {% if post.series %}
      {% assign series_posts = site.posts | where: 'series', post.series | sort: 'series_order' %}
      {% for series_post in series_posts %}
        {% if series_post.url == post.url %}
          {% assign series_index = forloop.index %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% capture post_search_content %}{{ post.content | strip_html }} {% include components/post-search-outcomes.html post=post %} {% include components/post-search-references.html post=post %}{% endcapture %}
    {% if has_item %},{% endif %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "category": {{ post.categories | first | default: "Uncategorized" | jsonify }},
      "type": "post",
      "tags": {% if post.tags %}{{ post.tags | jsonify }}{% else %}[]{% endif %},
      "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | jsonify }},
      "content": {{ post_search_content | normalize_whitespace | jsonify }},
      "date": "{{ post.date | date: "%Y-%m-%d" }}",
      "series": {% if post.series %}{{ post.series | jsonify }}{% else %}null{% endif %},
      "series_index": {% if series_index %}{{ series_index }}{% else %}null{% endif %}
    }
    {% assign has_item = true %}
  {% endfor %}

  {% for achievement in site.achievements %}
    {% capture achievement_eligible %}{% include components/achievement-searchable.html achievement=achievement %}{% endcapture %}
    {% if achievement_eligible == 'true' %}
      {% capture achievement_search_content %}
        {{ achievement.overview | escape }}
        {{ achievement.institution | escape }}
        {{ achievement.credential_id | escape }}
        {{ achievement.certificate_description | escape }}
        {% for item in achievement.highlights %}{{ item | escape }} {% endfor %}
        {% for item in achievement.tech_stack %}{{ item | escape }} {% endfor %}
        {% for item in achievement.skills %}{{ item | escape }} {% endfor %}
        {{ achievement.content | strip_html }}
      {% endcapture %}
      {% if has_item %},{% endif %}
      {
        "title": {{ achievement.title | append: '' | jsonify }},
        "url": {{ achievement.url | absolute_url | jsonify }},
        "category": "Uncategorized",
        "type": "page",
        "page_kind": "achievement",
        "language": {{ achievement.content_language | default: '' | append: '' | jsonify }},
        "tags": [],
        "description": {{ achievement.overview | default: achievement.title | escape | normalize_whitespace | jsonify }},
        "content": {{ achievement_search_content | normalize_whitespace | jsonify }},
        "date": "",
        "series": null,
        "series_index": null
      }
      {% assign has_item = true %}
    {% endif %}
  {% endfor %}

  {% for page in site.pages %}
    {% assign page_root = page.path | slice: 0, 6 %}
    {% assign searchable_page = false %}
    {% if page_root == 'tools/' or page.path contains '_pages/' %}
      {% assign searchable_page = true %}
    {% endif %}
    {% if searchable_page and page.title and page.permalink and page.layout != 'xml' %}
      {% if has_item %},{% endif %}
      {
        "title": {{ page.title | jsonify }},
        "url": {{ page.url | absolute_url | jsonify }},
        "category": "Uncategorized",
        "type": "page",
        "tags": [],
        "description": {{ page.description | default: page.title | strip_html | normalize_whitespace | jsonify }},
        "content": "",
        "date": {% if page.date %}{{ page.date | date: "%Y-%m-%d" | jsonify }}{% else %}""{% endif %},
        "series": null,
        "series_index": null
      }
      {% assign has_item = true %}
    {% endif %}
  {% endfor %}
]
